{
  "name": "copol-language",
  "displayName": "COPOL Language",
  "description": "Syntax highlighting for COPOL .cpl prompt documents, based on the COBOP reference palette.",
  "version": "0.1.0",
  "publisher": "copol-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "copol",
        "aliases": [
          "COPOL",
          "COBOP",
          "copol"
        ],
        "extensions": [
          ".cpl",
          ".CPL"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "copol",
        "scopeName": "source.copol",
        "path": "./syntaxes/copol.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "COPOL Reference Light",
        "uiTheme": "vs",
        "path": "./themes/copol-reference-light.json"
      }
    ],
    "configurationDefaults": {
      "[copol]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.wordWrap": "off",
        "editor.semanticHighlighting.enabled": false,
        "editor.bracketPairColorization.enabled": false
      }
    }
  }
}
